# ==============================================================================
# Accessible Onboarding & Career Gateway - Server Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development

# Database Connection (MongoDB)
# Local instance or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/savanna_gateway

# JWT Secrets for Authentication (Org Admins, Employers, Partners)
# In production, use strong cryptographically random strings (at least 32 characters)
JWT_SECRET=super_secret_jwt_access_key_min_32_characters_long_for_dev
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_characters_long_for_dev

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins or exact frontend URL
CORS_ORIGIN=http://localhost:3000

# Encryption Key for Sensitive Data at Rest (AES-256-GCM)
# Must be exactly 32 bytes (64 hex characters or 32 raw ASCII characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Logging Level (optional: trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
